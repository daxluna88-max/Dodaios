# DEFINITION - NOT RUN. Streams display :10 to noVNC. Not in the owner's unit list but
# required by jarvis-novnc.service (noVNC speaks WebSocket; something must speak RFB).
# Bound to LOOPBACK ONLY, and with a VNC password file as a second factor behind the
# authenticated proxy. TODO(verify): x11vnc option names on the Ubuntu 24.04 build
# (-localhost, -rfbauth, -unixsock/-unixsockonly); alternative TigerVNC x0vncserver
# with -rfbunixpath and -rfbport -1 (no TCP socket at all). Prefer the unix socket
# variant so even local processes need file permissions rather than a TCP connect.
[Unit]
Description=Jarvis VNC server for the live view (loopback only)
Requires=jarvis-xvfb.service
After=jarvis-xvfb.service jarvis-wm.service
JoinsNamespaceOf=jarvis-xvfb.service

[Service]
Type=simple
User=jarvis
Group=jarvis
EnvironmentFile=/etc/jarvis/node.env
# Per-boot VNC password: generated by jarvis-vnc-prepare.sh (root-owned, 0400 -> LoadCredential),
# handed to the gateway ticket, never shown to the customer. TODO(write): not written.
LoadCredential=vncpasswd:/etc/jarvis/vncpasswd
ExecStart=/usr/bin/x11vnc -display :10 -localhost -rfbport 5900 -rfbauth %d/vncpasswd -forever -shared -noxdamage -noipv6
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/run/jarvis
MemoryMax=256M
TasksMax=32
CPUQuota=100%
# loopback only, in addition to the 127.0.0.1 bind and the nftables input policy
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8

[Install]
WantedBy=multi-user.target
