# /etc/jarvis/node.env  (root:root 0644)  - DEFINITION, NOT RUN. NON-SECRET values only.
# Secrets never go here (nor in unit files, nor cloud-init user-data).
DISPLAY=:10
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/jarvis/bus
XDG_RUNTIME_DIR=/run/jarvis
HOME=/data/home
LANG=en_US.UTF-8
# Product data root (ADR-0054 / ADR-0065 section 3.5). TODO(verify): product_profile.check_product_root
# (canonical=True) requires the root to equal "<shared-root>-consumer"; confirm that
# JARVIS_DATA_DIR=/data/jarvis-consumer satisfies it on a headless host, never done.
JARVIS_DATA_DIR=/data/jarvis-consumer
JARVIS_CONFIG=/data/jarvis-consumer/dodaios.toml
JARVIS_NONINTERACTIVE=1
JARVIS_BIND_HOST=127.0.0.1
PLAYWRIGHT_BROWSERS_PATH=/opt/jarvis/current/browsers
# Browser sandbox stays ON. Nothing in this file sets --no-sandbox (see docs/CHROMIUM-LAUNCH-PROFILE.md).
# ---- PROPOSED variables (do NOT exist in the code today; see DEPENDENCY-MAP.md gaps G1-G9) ----
# JARVIS_CLOUD_NODE=1                    # master switch: disable self-update/marketplace/attach/manual_chrome
# JARVIS_INFERENCE_BROKER_URL=https://TODO-broker.invalid:TODO-port   # engine calls go here, no provider key in guest
# JARVIS_INFERENCE_BROKER_TOKEN_FILE=/run/credentials/jarvis-runtime.service/broker-token   # systemd LoadCredential
# JARVIS_AGENT_SCREEN_EXISTING_DISPLAY=:10   # agent_screen xvfb provider attaches instead of spawning Xvfb
