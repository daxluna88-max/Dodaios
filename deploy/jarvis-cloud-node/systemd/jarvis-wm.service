# DEFINITION - NOT RUN. openbox: a focus model for click-by-window and switch_window
# (see agent_screen/providers/xvfb.py _WINDOW_MANAGERS). No panel, no desktop, no menu autostart.
[Unit]
Description=Jarvis window manager (openbox) on :10
Requires=jarvis-xvfb.service jarvis-dbus.service
After=jarvis-xvfb.service jarvis-dbus.service
JoinsNamespaceOf=jarvis-xvfb.service

[Service]
Type=simple
User=jarvis
Group=jarvis
EnvironmentFile=/etc/jarvis/node.env
# --startup omitted on purpose: openbox must not autostart anything from the agent-writable home.
# TODO(owner): ship a root-owned rc.xml via --config-file /opt/jarvis/current/etc/openbox-rc.xml
# so the agent cannot add keybindings that exec arbitrary commands (harmless to the agent's own
# privileges, but it keeps the takeover desktop predictable).
ExecStart=/usr/bin/openbox --sm-disable
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/run/jarvis /data/home/.config /data/home/.cache
MemoryMax=128M
TasksMax=32
CPUQuota=20%
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
