# DEFINITION - NOT RUN. Session D-Bus for the agent's desktop (AT-SPI, portals,
# libsecret NOT used: keyring stays the 0600 file backend, see ADR-0065 D1).
# This is a SYSTEM unit running a *session* bus as user jarvis on a fixed unix
# path, instead of `systemd --user` + linger, so the sandboxing directives below
# apply and no PAM session is needed. See jarvis-dbus.NOTES.md for the --user
# alternative and trade-offs.
[Unit]
Description=Jarvis session D-Bus (agent desktop)
Requires=nftables.service
After=nftables.service local-fs.target

[Service]
Type=simple
User=jarvis
Group=jarvis
RuntimeDirectory=jarvis
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/dbus-daemon --session --nofork --nopidfile --address=unix:path=/run/jarvis/bus
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/run/jarvis
MemoryMax=128M
TasksMax=64
CPUQuota=10%
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
