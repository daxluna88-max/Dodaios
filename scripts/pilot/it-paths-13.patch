+            # A model that invents "C:\\Users\\..." would otherwise create a file
+            # literally named that, here, and report success.
+            message = (
+                f"{foreign!r} is a Windows path and this machine is not Windows. "
+                "Use a path relative to the working folder, e.g. 'notes.md'."
+            )
+            return ToolResult(success=False, output=message, error=message)
