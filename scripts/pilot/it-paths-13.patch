+_DRIVE_PATH: Final[re.Pattern[str]] = re.compile(r"^[A-Za-z]:[\\/]")
+
+
+def _foreign_drive_path(args: dict[str, Any] | None) -> str | None:
+    """The first ``C:\\...`` style path argument, when this is not Windows."""
+    if os.name == "nt":
+        return None
+    for key in ("file_path", "path"):
+        value = (args or {}).get(key)
+        if isinstance(value, str) and _DRIVE_PATH.match(value.strip()):
+            return value
+    return None
+
