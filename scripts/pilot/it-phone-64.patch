+  }
+}
+
+function openChat(sid, title) {
+  newView();
+  state.sid = sid;
+  state.sig = "";
+  state.pending = [];
+  const draft = state.drafts.get(sid) || { text: "", staged: [] };
+  state.staged = draft.staged;
