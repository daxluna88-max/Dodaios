diff --git a/dodaios/ui/web/mobile/pair.js b/dodaios/ui/web/mobile/pair.js
new file mode 100644
index 0000000000000000000000000000000000000000..4cfaa5281768d450dd313ac5675c4b66a86cfe08
--- /dev/null
+++ b/dodaios/ui/web/mobile/pair.js
@@ -0,0 +1,93 @@
+// Owner page: mint a pairing code, list and revoke phones, publish a file to them.
+// It runs in the computer's own browser; a remote browser must present the Control Key,
+// which is kept in this page's memory only.
+"use strict";
+const $ = (id) => document.getElementById(id);
+let bearer = "";
+let expiresAt = 0;
+let ticker = 0;
+
+async function call(path, options = {}) {
+  const headers = { ...(options.headers || {}) };
+  if (bearer) headers.Authorization = `Bearer ${bearer}`;
+  if (options.body) headers["Content-Type"] = "application/json";
+  const res = await fetch(path, { ...options, headers, body: options.body ? JSON.stringify(options.body) : undefined, credentials: "same-origin" });
+  if (res.status === 401 || res.status === 403) { const e = new Error("auth"); e.auth = true; throw e; }
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) throw new Error(typeof data.detail === "string" ? data.detail : res.statusText);
+  return data;
+}
+
+function needKey() {
+  $("pair").hidden = true;
+  $("login").hidden = false;
+}
+
+async function newCode() {
+  try {
+    const out = await call("/api/phone-admin/pairing", { method: "POST" });
+    $("login").hidden = true;
+    $("pair").hidden = false;
+    $("code").textContent = out.code;
+    $("url").textContent = `${location.origin}/m/`;
+    expiresAt = Date.now() + out.expires_in * 1000;
+    clearInterval(ticker);
+    ticker = setInterval(tick, 1000);
+    tick();
+    await devices();
+  } catch (error) {
+    if (error.auth) return needKey();
+    $("code").textContent = "—";
+    $("left").textContent = error.message;
+    $("login").hidden = true;
+    $("pair").hidden = false;
+  }
+}
+
+function tick() {
+  const left = Math.max(0, Math.round((expiresAt - Date.now()) / 1000));
+  $("left").textContent = left ? `Scade tra ${Math.floor(left / 60)}:${String(left % 60).padStart(2, "0")}` : "Scaduto: crea un nuovo codice.";
+  if (!left) $("code").style.opacity = "0.35"; else $("code").style.opacity = "1";
+}
+
+async function devices() {
+  const box = $("devices");
+  box.replaceChildren();
+  const { devices: list } = await call("/api/phone-admin/devices");
+  const live = list.filter((d) => !d.revoked);
+  if (!live.length) { const p = document.createElement("p"); p.className = "mute"; p.textContent = "Nessun telefono collegato."; box.append(p); }
+  for (const d of live) {
+    const row = document.createElement("div");
+    row.className = "box dev";
+    const text = document.createElement("div");
+    text.className = "g";
+    text.textContent = d.name;
+    const seen = document.createElement("small");
+    seen.textContent = ` · visto ${new Date(d.last_seen * 1000).toLocaleString("it-IT")}`;
+    text.append(seen);
+    const revoke = document.createElement("button");
+    revoke.className = "danger";
+    revoke.textContent = "Revoca";
+    revoke.onclick = async () => {
+      if (!confirm(`Revocare ${d.name}? Smette subito di funzionare.`)) return;
+      await call(`/api/phone-admin/devices/${d.id}`, { method: "DELETE" });
+      devices();
+    };
+    row.append(text, revoke);
+    box.append(row);
+  }
+}
+
+$("new").onclick = newCode;
+$("keygo").onclick = () => { bearer = $("key").value.trim(); $("key").value = ""; newCode(); };
+$("send").onclick = async () => {
+  const path = $("path").value.trim();
+  if (!path) return;
+  $("sent").textContent = "Invio…";
+  try {
+    const out = await call("/api/phone-admin/outbox", { method: "POST", body: { path } });
+    $("sent").textContent = `Pronto sul telefono: ${out.name}`;
+    $("path").value = "";
+  } catch (error) { $("sent").textContent = error.auth ? "Non autorizzato." : error.message; }
+};
+newCode();
diff --git a/dodaios/ui/web/mobile/sha256.js b/dodaios/ui/web/mobile/sha256.js
new file mode 100644
index 0000000000000000000000000000000000000000..938a6a2cf2bd126c992d508e07e034b81a50ba94
--- /dev/null
+++ b/dodaios/ui/web/mobile/sha256.js
@@ -0,0 +1,74 @@
+// Incremental SHA-256. crypto.subtle cannot hash a stream and does not exist on plain http, and a
+// video must be hashed in slices, so the phone panel carries its own (checked against Node's crypto).
+"use strict";
+
+const SHA256_K = new Uint32Array([
+  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+]);
+
+class Sha256 {
+  constructor() {
+    this.h = new Uint32Array([0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]);
+    this.buf = new Uint8Array(64);
+    this.fill = 0;
+    this.length = 0;
+    this.w = new Uint32Array(64);
+  }
+
+  update(bytes) {
+    this.length += bytes.length;
+    let i = 0;
+    if (this.fill) {
+      while (i < bytes.length && this.fill < 64) this.buf[this.fill++] = bytes[i++];
+      if (this.fill === 64) { this._block(this.buf, 0); this.fill = 0; }
+    }
+    for (; i + 64 <= bytes.length; i += 64) this._block(bytes, i);
+    while (i < bytes.length) this.buf[this.fill++] = bytes[i++];
+    return this;
+  }
+
+  _block(data, at) {
+    const w = this.w, h = this.h;
+    for (let t = 0; t < 16; t++, at += 4) w[t] = (data[at] << 24) | (data[at + 1] << 16) | (data[at + 2] << 8) | data[at + 3];
+    for (let t = 16; t < 64; t++) {
+      const a = w[t - 15], b = w[t - 2];
+      const s0 = ((a >>> 7) | (a << 25)) ^ ((a >>> 18) | (a << 14)) ^ (a >>> 3);
+      const s1 = ((b >>> 17) | (b << 15)) ^ ((b >>> 19) | (b << 13)) ^ (b >>> 10);
+      w[t] = (w[t - 16] + s0 + w[t - 7] + s1) | 0;
+    }
+    let a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], k = h[7];
+    for (let t = 0; t < 64; t++) {
+      const S1 = ((e >>> 6) | (e << 26)) ^ ((e >>> 11) | (e << 21)) ^ ((e >>> 25) | (e << 7));
+      const ch = (e & f) ^ (~e & g);
+      const t1 = (k + S1 + ch + SHA256_K[t] + w[t]) | 0;
+      const S0 = ((a >>> 2) | (a << 30)) ^ ((a >>> 13) | (a << 19)) ^ ((a >>> 22) | (a << 10));
+      const maj = (a & b) ^ (a & c) ^ (b & c);
+      const t2 = (S0 + maj) | 0;
+      k = g; g = f; f = e; e = (d + t1) | 0; d = c; c = b; b = a; a = (t1 + t2) | 0;
+    }
+    h[0] = (h[0] + a) | 0; h[1] = (h[1] + b) | 0; h[2] = (h[2] + c) | 0; h[3] = (h[3] + d) | 0;
+    h[4] = (h[4] + e) | 0; h[5] = (h[5] + f) | 0; h[6] = (h[6] + g) | 0; h[7] = (h[7] + k) | 0;
+  }
+
+  hex() {
+    const bits = this.length * 8;
+    const pad = new Uint8Array(((this.fill < 56 ? 56 : 120) - this.fill) + 8);
+    pad[0] = 0x80;
+    const view = new DataView(pad.buffer);
+    view.setUint32(pad.length - 8, Math.floor(bits / 0x100000000));
+    view.setUint32(pad.length - 4, bits >>> 0);
+    const keep = this.length;
+    this.update(pad);
+    this.length = keep;
+    return Array.from(this.h, (x) => (x >>> 0).toString(16).padStart(8, "0")).join("");
+  }
+}
+
+if (typeof module !== "undefined") module.exports = { Sha256 };
diff --git a/dodaios/ui/web/mobile/sw.js b/dodaios/ui/web/mobile/sw.js
new file mode 100644
index 0000000000000000000000000000000000000000..e7aea2d2022a3d862f64ab4c96bb077cf4c5a173
--- /dev/null
+++ b/dodaios/ui/web/mobile/sw.js
@@ -0,0 +1,15 @@
+// Shell only: the panel opens offline, but every /api call goes to the network (never cached).
+// The cache is owned by this panel: only caches named "jarvis-panel-*" are ever deleted, and only
+// same-origin GETs under /m/ are handled, so installing the panel cannot touch other app caches.
+const PREFIX = "jarvis-panel-";
+const SHELL = `${PREFIX}v3`;
+const FILES = ["/m/", "/m/app.js", "/m/sha256.js", "/m/manifest.webmanifest", "/m/icon-256.png"];
+self.addEventListener("install", (e) => e.waitUntil(caches.open(SHELL).then((c) => c.addAll(FILES))));
+self.addEventListener("activate", (e) => e.waitUntil(
+  caches.keys().then((keys) => Promise.all(
+    keys.filter((k) => k.startsWith(PREFIX) && k !== SHELL).map((k) => caches.delete(k))))));
+self.addEventListener("fetch", (e) => {
+  const url = new URL(e.request.url);
+  if (e.request.method !== "GET" || url.origin !== self.location.origin || !url.pathname.startsWith("/m/")) return;
+  e.respondWith(fetch(e.request).catch(() => caches.match(e.request)));
+});
diff --git a/dodaios/ui/web/phone_routes.py b/dodaios/ui/web/phone_routes.py
new file mode 100644
index 0000000000000000000000000000000000000000..93d1570ebb17fe57caec7ce6a1a71bf32ffa1cc4
--- /dev/null
+++ b/dodaios/ui/web/phone_routes.py
@@ -0,0 +1,504 @@
+"""Routes behind the phone companion (``/m/``).
+
+Two surfaces, kept apart on purpose:
+
+* ``/api/phone-admin/*`` — what the OWNER does on the computer (mint a pairing code, list and
+  revoke devices, publish a file to the phone). It sits behind the normal Jarvis guard
+  (session cookie, loopback open access, or the Control Key); no phone credential reaches it.
+* ``/api/phone/*`` — what a PAIRED PHONE may do: chat, approvals, stop, and its own file
+  transfers. The outer guard lets these through (:func:`_http_auth_exception`), so every handler
+  authenticates the device itself, re-reading the device row on every request: revocation is
+  immediate for sessions, uploads and downloads in flight.
+
+The phone's credential is a random token in an HttpOnly, SameSite=Strict cookie scoped to
+``/api/phone``; unsafe methods also need the device's CSRF token in ``X-Phone-CSRF`` and an Origin
+that matches the Host. Chat calls reuse the desktop chat routes' own functions, so approvals,
+cancellation and queuing behave exactly as they do there.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import os
+import re
+import time
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any
+from urllib.parse import quote, urlsplit
+
+from fastapi import APIRouter, Depends, HTTPException, Request, Response
+from fastapi.responses import StreamingResponse
+from pydantic import BaseModel, Field
+
+from dodaios.agent_chat import attachments as chat_attachments
+from dodaios.phone.devices import DeviceRegistry, PairingError, csrf_matches
+from dodaios.phone.store import NotFound, Revoked, TransferError, TransferStore
+
+router = APIRouter(prefix="/api/phone", tags=["phone"])
+admin_router = APIRouter(prefix="/api/phone-admin", tags=["phone"])
+
+COOKIE = "jphone"
+CSRF_HEADER = "x-phone-csrf"
+COOKIE_MAX_AGE = 90 * 24 * 3600
+_SWEEP_EVERY_S = 600.0
+#: Types a phone may preview inline (in a sandboxed response); everything else downloads.
+_INLINE_TYPES = {
+    ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".png": "image/png", ".gif": "image/gif",
+    ".webp": "image/webp", ".mp4": "video/mp4", ".mov": "video/quicktime",
+    ".mp3": "audio/mpeg", ".m4a": "audio/mp4", ".wav": "audio/wav",
+}
+
+
+class _Hub:
+    """The registry and the store of one app, built on first use."""
+
+    def __init__(self, root: Path) -> None:
+        self.registry = DeviceRegistry(root)
+        self.store = TransferStore(root / "files")
+        self._swept = 0.0
+
+    def sweep_if_due(self) -> None:
+        now = time.monotonic()
+        if now - self._swept >= _SWEEP_EVERY_S:
+            self._swept = now
+            self.store.sweep()
+
+
+def _hub(request: Request) -> _Hub:
+    state = request.app.state
+    hub = getattr(state, "phone_hub", None)
+    if hub is None:
+        cfg = getattr(state, "config", None)
+        data_dir = getattr(getattr(cfg, "memory", None), "data_dir", None) or "data"
+        hub = state.phone_hub = _Hub(Path(data_dir) / "phone")
+    return hub
+
+
+def _same_origin(request: Request) -> bool:
+    origin = request.headers.get("origin")
+    host = request.headers.get("host", "").lower()
+    if not origin or not host:
+        return False
+    return urlsplit(origin).netloc.lower() == host
+
+
+def _secure(request: Request) -> bool:
+    return request.url.scheme == "https" or request.headers.get("x-forwarded-proto") == "https"
+
+
+def _device(request: Request) -> dict[str, Any]:
+    """The live paired device behind this request, else 401. Also enforces the CSRF rules."""
+    hub = _hub(request)
+    device = hub.registry.authenticate(request.cookies.get(COOKIE))
+    if device is None:
+        raise HTTPException(status_code=401, detail="not paired")
+    if request.method not in ("GET", "HEAD"):
+        if not _same_origin(request) or not csrf_matches(
+            device["csrf"], request.headers.get(CSRF_HEADER)
+        ):
+            raise HTTPException(status_code=403, detail="request refused")
+    return device
+
+
+def _owner(request: Request) -> str:
+    return _hub(request).registry.owner
+
+
+def _guard(request: Request, device: dict[str, Any]) -> Any:
+    """A callable answering "is this device still paired?" for a mutation's last look."""
+    registry = _hub(request).registry
+    return lambda: registry.is_active(device["id"])
+
+
+def _ensure_active(request: Request, device: dict[str, Any]) -> None:
+    """Re-check membership after an await that may have outlived the request's entry check."""
+    if not _hub(request).registry.is_active(device["id"]):
+        raise HTTPException(status_code=401, detail="not paired")
+
+
+def _store_call(fn: Any, *args: Any, **kwargs: Any) -> Any:
+    try:
+        return fn(*args, **kwargs)
+    except Revoked as exc:
+        raise HTTPException(status_code=401, detail="not paired") from exc
+    except NotFound as exc:
+        raise HTTPException(status_code=404, detail="file not found") from exc
+    except TransferError as exc:
+        status = 409 if "offset" in str(exc) else 400
+        raise HTTPException(status_code=status, detail=str(exc)) from exc
+
+
+# ------------------------------------------------------------------ pairing
+class RedeemBody(BaseModel):
+    code: str = Field(max_length=32)
+    name: str = Field(default="", max_length=80)
+
+
+@router.post("/pair/redeem")
+async def redeem(body: RedeemBody, request: Request, response: Response) -> dict[str, Any]:
+    if not _same_origin(request):
+        raise HTTPException(status_code=403, detail="request refused")
+    hub = _hub(request)
+    try:
+        device, token = await asyncio.to_thread(hub.registry.redeem, body.code, body.name)
+    except PairingError as exc:
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+    response.set_cookie(
+        COOKIE, token, max_age=COOKIE_MAX_AGE, path="/api/phone", httponly=True,
+        samesite="strict", secure=_secure(request),
+    )
+    return {"device": {k: v for k, v in device.items() if k != "csrf"}, "csrf": device["csrf"]}
+
+
+@router.get("/me")
+def me(device: dict[str, Any] = Depends(_device)) -> dict[str, Any]:  # noqa: B008
