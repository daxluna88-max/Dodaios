diff --git a/dodaios/ui/web/mobile/index.html b/dodaios/ui/web/mobile/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..8094badaa3a79db745607d878905abc4a3c57924
--- /dev/null
+++ b/dodaios/ui/web/mobile/index.html
@@ -0,0 +1,85 @@
+<!doctype html>
+<html lang="it">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<meta name="theme-color" content="#0b0d12">
+<meta name="apple-mobile-web-app-capable" content="yes">
+<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
+<meta name="apple-mobile-web-app-title" content="Jarvis">
+<link rel="manifest" href="/m/manifest.webmanifest">
+<link rel="apple-touch-icon" href="/m/icon-256.png">
+<title>Jarvis</title>
+<style>
+:root{--bg:#0b0d12;--panel:#151922;--line:#262c38;--fg:#e8ebf1;--mute:#8a93a6;--acc:#5b8cff;--ok:#2fbf71;--bad:#e5484d;--warn:#f5a524}
+@media (prefers-color-scheme:light){:root{--bg:#f4f5f8;--panel:#fff;--line:#dfe2ea;--fg:#14171f;--mute:#667085}}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0;background:var(--bg);color:var(--fg);font:16px/1.4 -apple-system,system-ui,sans-serif}
+#app{display:flex;flex-direction:column;height:100dvh;padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom)}
+header{display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--line)}
+header h1{font-size:17px;margin:0;flex:1}
+button{font:inherit;color:var(--fg);background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 14px;min-height:44px}
+button.primary{background:var(--acc);border-color:var(--acc);color:#fff}
+button.danger{background:var(--bad);border-color:var(--bad);color:#fff}
+button:disabled{opacity:.5}
+main{flex:1;overflow-y:auto;padding:12px 14px;-webkit-overflow-scrolling:touch}
+.row{padding:12px;border:1px solid var(--line);border-radius:12px;background:var(--panel);margin-bottom:8px}
+.row small{color:var(--mute);display:block}
+.msg{width:fit-content;max-width:88%;margin:6px 0;padding:9px 12px;border-radius:14px;white-space:pre-wrap;word-wrap:break-word}
+.msg.user{margin-left:auto;background:var(--acc);color:#fff}
+.msg.bot{background:var(--panel);border:1px solid var(--line)}
+.msg.err{border-color:var(--bad);color:var(--bad)}
+.act{color:var(--mute);font-size:13px;margin:4px 0}
+.card{border:1px solid var(--warn);background:var(--panel);border-radius:12px;padding:12px;margin:8px 0}
+.card pre{white-space:pre-wrap;word-break:break-word;margin:6px 0;font-size:13px;color:var(--mute);max-height:160px;overflow:auto}
+.card .btns{display:flex;gap:8px;flex-wrap:wrap}
+.card .btns button{flex:1}
+#status{padding:6px 14px;font-size:13px;color:var(--mute);display:flex;align-items:center;gap:8px;border-top:1px solid var(--line)}
+#status .grow{flex:1}
+footer{padding:8px 10px;border-top:1px solid var(--line);display:flex;gap:6px;align-items:flex-end}
+footer textarea{flex:1;resize:none;max-height:120px;font:inherit;color:var(--fg);background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:10px;min-height:44px}
+.chips{display:flex;gap:6px;flex-wrap:wrap;padding:0 10px}
+.chip{font-size:13px;background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:3px 10px}
+input[type=password],input[type=text]{width:100%;font:inherit;color:var(--fg);background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px;margin:8px 0}
+.tabs{display:flex;border-top:1px solid var(--line)}
+.tabs button{flex:1;border:0;border-radius:0;background:transparent;color:var(--mute)}
+.tabs button.on{color:var(--acc);font-weight:600}
+.file{display:flex;gap:10px;align-items:center}
+.file .grow{flex:1;min-width:0}
+.file .name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.file img{width:48px;height:48px;object-fit:cover;border-radius:8px}
+.file a{color:var(--acc);text-decoration:none;padding:8px}
+.bar{height:6px;border-radius:3px;background:var(--line);overflow:hidden;margin-top:6px}
+.bar i{display:block;height:100%;background:var(--acc);width:0}
+.bar.err i{background:var(--bad)}
+h2{font-size:14px;color:var(--mute);margin:14px 0 6px;font-weight:600;text-transform:uppercase}
+.hide{display:none!important}
